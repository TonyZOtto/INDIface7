   <text:h text:style-name="Heading_20_2" text:outline-level="2">EclipseIR Applications</text:h>
   <text:p text:style-name="Heading">MatchPointIR, SearchPointIR, ResolverIR</text:p>
   <text:p text:style-name="Text_20_body">This chapter will <text:span text:style-name="T17">...</text:span></text:p>
   <text:h text:style-name="P35" text:outline-level="2">The BAGger</text:h>
   <text:p text:style-name="P20">Rapid Biometric Application Generation</text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T19">This chapter </text:span><text:span text:style-name="T17">...</text:span></text:p>
