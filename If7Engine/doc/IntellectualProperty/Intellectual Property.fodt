   <text:p text:style-name="P6"/>
   <text:p text:style-name="P12"/>
   <text:h text:style-name="P35" text:outline-level="2">Frontal Face Detection</text:h>
   <text:p text:style-name="P20">.</text:p>
   <text:p text:style-name="P12">The base for <text:span text:style-name="T9">INDIface</text:span> object detection is the Haar Classifier Cascade mechanism provided by the Intel&apos;s OpenCV computer vision library. <text:span text:style-name="T9">INDIface</text:span> first scans an image or a single frame of video for potential frontal faces. At this time we do not correlate objects from one frame to the next. </text:p>
   <text:p text:style-name="P12"/>
   <table:table table:name="Table15" table:style-name="Table15">
    <table:table-column table:style-name="Table15.A"/>
