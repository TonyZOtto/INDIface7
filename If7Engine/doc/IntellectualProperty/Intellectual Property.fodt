   <text:p text:style-name="P20">.</text:p>
   <text:h text:style-name="P35" text:outline-level="2">IP Protection</text:h>
   <text:p text:style-name="P20">How EclipseIR will protect its Intellectual Property</text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T19">This chapter will </text:span><text:span text:style-name="T17">...</text:span></text:p>
   <text:h text:style-name="P41" text:outline-level="3">Patent</text:h>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T19">EclipseIR will </text:span><text:span text:style-name="T17">...</text:span></text:p>
   <text:h text:style-name="P41" text:outline-level="3">Copyright</text:h>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T19">EclipseIR will </text:span><text:span text:style-name="T17">...</text:span></text:p>
   <text:h text:style-name="P41" text:outline-level="3">Trademark &amp; Other Marks</text:h>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T19">EclipseIR will </text:span><text:span text:style-name="T17">...</text:span></text:p>
   <text:h text:style-name="P41" text:outline-level="3">Trade Secret</text:h>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T19">EclipseIR will </text:span><text:span text:style-name="T17">...</text:span></text:p>
   <text:h text:style-name="P41" text:outline-level="3">Other Protection</text:h>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T19">EclipseIR will </text:span><text:span text:style-name="T17">...</text:span></text:p>
   <text:h text:style-name="P39" text:outline-level="1">Frame Processing</text:h>
   <text:p text:style-name="P19">Pre-processing &amp; Object Detection</text:p>
   <text:p text:style-name="P45"/>
